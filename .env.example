# Copy this file to .env, or just run: ./scripts/init-env.sh
# (init-env.sh creates .env and generates a random database password for you.)
# .env is gitignored. NEVER commit it. Only this .env.example is committed.

# --- Database (synthetic data only) ---
POSTGRES_USER=apex
POSTGRES_DB=apex_ops
# Left blank on purpose: init-env.sh fills it with a random value.
POSTGRES_PASSWORD=

# --- Application ---
# Image name (change to ghcr.io/<owner>/apex-ops-api to use the registry image)
IMAGE=apex-ops-api
# Default version used by plain `docker compose` commands. deploy.sh overrides it.
APP_VERSION=v1.0.0
# Host port the API is published on (bound to 127.0.0.1 only)
APP_PORT=3000
LOG_LEVEL=info
